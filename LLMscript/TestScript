# BIFS 614 Question and Answer Tutor - V3

from transformers import AutoTokenizer, AutoModelForCausalLM
from sentence_transformers import SentenceTransformer
import faiss
import pickle
import torch
import time
import re

# ============================================================
# CourseAgentQuestionandAnswer
# BIFS 614 Tutor Mode
#
# V7 Goal:
# Improve retrieval grounding and prevent Phi-3 from answering
# questions that are unsupported by the BIFS 614 course content.
#
# FAISS searches the five nearest candidate chunks. The two
# closest qualifying chunks are passed to Phi-3 as course
# context.
#
# Questions whose best retrieved chunk exceeds the maximum
# allowed distance are rejected before being sent to Phi-3.
# ============================================================

# print(
#     f"GPU: {torch.cuda.get_device_name(0)}"
#     if torch.cuda.is_available()
#     else "No GPU"
# )

# ============================================================
# Model
# ============================================================

MODEL_NAME = "microsoft/Phi-3-mini-4k-instruct"

print("Loading Phi-3 model...")

tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)

model = AutoModelForCausalLM.from_pretrained(
    MODEL_NAME,
    device_map="auto"
)

model.eval()

print("Model loaded successfully.")
# print(f"Model device: {model.device}")

# Phi-3 uses <|end|> to mark the end of a turn.
END_TOKEN_ID = tokenizer.convert_tokens_to_ids("<|end|>")


# ============================================================
# Embedding Model
# ============================================================

print("Loading embedding model...")

embedding_model = SentenceTransformer(
    "sentence-transformers/all-MiniLM-L6-v2"
)

print("Embedding model loaded.")


# ============================================================
# Load FAISS Vector Database
# ============================================================

index = faiss.read_index("knowledge.index")

with open("chunks.pkl", "rb") as f:
    chunks = pickle.load(f)

# print(f"Knowledge base loaded: {len(chunks)} chunks.")


# ============================================================
# Retrieval Settings
# ============================================================

# Retrieve a broader set of candidate chunks from FAISS.
CANDIDATE_K = 5

# Number of chunks actually passed to Phi-3.
CONTEXT_K = 2

# If even the best candidate exceeds this distance,
# reject the question as unrelated to the course material.
MAX_DISTANCE = 1.50


# ============================================================
# Optional grounding diagnostics
# ============================================================
# Students do not see diagnostic output by default.
# Set True while testing to inspect retrieved evidence and warnings.
DEBUG_GROUNDING = False

# If True, a response containing an unfamiliar technical term is
# withheld rather than displayed. This is intentionally OFF by default:
# the check is heuristic and can reject valid paraphrases.
STRICT_TERM_CHECK = False

FALLBACK = "I could not find the answer in the provided context."

# Common words are not considered technical terms by this heuristic.
# This is not a claim-level factual verification system.
COMMON_WORDS = {
    "because", "between", "different", "information", "important",
    "provides", "provided", "question", "response", "example",
    "examples", "includes", "including", "similar", "specific",
    "process", "processes", "elements", "individual", "compared",
    "comparison", "efficient", "efficiency", "structure", "structures",
    "organizes", "organize", "organized", "organizing", "distance",
    "distances", "repeated", "repeatedly", "closest", "starting",
    "results", "resulting", "allows", "allowing", "requires",
    "require", "required", "however", "therefore", "through",
    "without", "within", "related", "represent", "represents",
    "representing", "number", "numbers", "dataset", "datasets",
    "contains", "contain", "containing", "relevant", "meaning",
    "usually", "typically", "according", "material", "lecture",
    "course", "context", "describes", "described", "explain",
    "explains", "analysis", "analyzing", "technique", "techniques",
    "method", "methods", "beginning", "together", "another",
    "original", "possible", "computing", "computed", "computational",
    "following", "several", "single", "rather", "instead", "given",
    "using", "which", "their", "these", "those", "where", "while",
    "after", "before", "until", "every", "first", "second",
}


def unsupported_technical_terms(answer, context):
    """Heuristic warning: long answer words absent from retrieved context.

    Does NOT establish whether an answer is true or entailed.
    """
    source_words = set(re.findall(r"[a-zA-Z]+", context.lower()))
    answer_words = set(re.findall(r"[a-zA-Z]+", answer.lower()))
    unknown = []
    for word in sorted(answer_words):
        if len(word) < 9 or word in COMMON_WORDS:
            continue
        # Accept simple inflection changes when a matching root exists.
        roots = {word, word.rstrip("s"), word.removesuffix("ing"),
                 word.removesuffix("ed"), word.removesuffix("ly")}
        if not any(root in source_words for root in roots if root):
            unknown.append(word)
    return unknown


# ============================================================
# Hybrid retrieval: exact phrase matches + FAISS
# ============================================================
# Exact matching is deliberately limited to informative phrases,
# to avoid matching generic words like "what" or "analysis".
# This is an additional retrieval route, NOT proof that a chunk
# supports an answer. It helps with acronyms such as SAGE.

def lexical_search_phrases(question):
    q = re.sub(r"[^a-z0-9]+", " ", question.lower()).strip()
    # Remove common question framing while preserving topic wording.
    q = re.sub(
        r"^(?:what is|what are|define|explain|describe|tell me about|"
        r"how does|how do|why is|why are)\s+", "", q
    )
    q = re.sub(r"^(?:a|an|the)\s+", "", q)
    q = re.sub(r"\b(?:in the course|in our lectures|please)\b", "", q).strip()
    words = q.split()
    phrases = []
    if len(words) >= 2 and len(q) >= 5:
        phrases.append(q)
    # Also try distinctive uppercase acronyms found in the question.
    for acronym in re.findall(r"\b[A-Z]{2,8}\b", question):
        if acronym.lower() not in {"WHAT", "HOW", "WHY", "THE", "AND"}:
            phrases.append(acronym.lower())
    return list(dict.fromkeys(phrases))


def lexical_matches(question):
    phrases = lexical_search_phrases(question)
    if not phrases:
        return []
    matches = []
    for i, chunk in enumerate(chunks):
        content = str(chunk).lower()
        # Boundary checks stop "SAGE" matching words like "message".
        for phrase in phrases:
            if re.search(r"(?<![a-z0-9])" + re.escape(phrase) +
                         r"(?![a-z0-9])", content):
                matches.append(i)
                break
    return matches


# ============================================================
# Retrieval Function
# ============================================================

def retrieve_context(question):
    # 1. Semantic FAISS candidates (original V2 settings preserved).
    query_embedding = embedding_model.encode(
        [question], convert_to_numpy=True
    )
    faiss.normalize_L2(query_embedding)
    distances, indices = index.search(query_embedding, CANDIDATE_K)

    semantic_candidates = [
        (int(idx), float(distance))
        for distance, idx in zip(distances[0], indices[0])
        if idx >= 0 and distance <= MAX_DISTANCE
    ]

    # 2. Literal phrase matches from chunks.pkl. These are allowed
    # even if FAISS failed to rank them in its nearest candidates.
    literal_ids = lexical_matches(question)

    # 3. Prefer exact topic mentions, but keep the original FAISS
    # results as a fallback for questions without a literal match.
    selected_ids = []
    for idx in literal_ids:
        if idx not in selected_ids:
            selected_ids.append(idx)
        if len(selected_ids) >= CONTEXT_K:
            break

    for idx, distance in semantic_candidates:
        if len(selected_ids) >= CONTEXT_K:
            break
        if idx not in selected_ids:
            selected_ids.append(idx)

    if DEBUG_GROUNDING:
        print("[DEBUG] Literal match indices:", literal_ids[:15])
        print("[DEBUG] FAISS qualifying candidates:", semantic_candidates)
        print("[DEBUG] Selected indices:", selected_ids)

    if not selected_ids:
        return None

    return "\n\n".join(str(chunks[idx]) for idx in selected_ids)


# ============================================================
# Interactive Tutor Loop
# ============================================================

print("\nBIFS 614 Question and Answer Tutor")
# print("Adaptive Retrieval Test")  # Developer-only message
print("Type 'quit', 'exit', or 'q' to stop.\n")

while True:

    user_prompt = input("Student Question: ").strip()

    if user_prompt.lower() in ["quit", "exit", "q"]:
        print("Goodbye!")
        break

    if not user_prompt:
        continue


    # ========================================================
    # Retrieve Course Content
    # ========================================================

    start = time.time()

    context = retrieve_context(user_prompt)

    retrieval_time = time.time() - start

#     print("Retrieval:", retrieval_time, "seconds")


    # ========================================================
    # Retrieval Guardrail
    # ========================================================

    # If no sufficiently relevant course content was retrieved,
    # do NOT send the question to Phi-3.
    #
    # This prevents Phi-3 from answering an unrelated question
    # using its pretrained outside knowledge.
    if context is None:

        response = (
            "I could not find the answer in the provided context."
        )

        print("Tutor Response:", response)
        continue


#     print(
#         "Retrieved course context chars:",
#         len(context)
#     )


    # ========================================================
    # Diagnostic: Display Retrieved Context
    # ========================================================

    # Keep this visible during testing so we can compare the
    # retrieved material with Phi-3's generated answer.
#     print("\n========== RETRIEVED CONTEXT ==========")
#     print(context)
#     print("========== END RETRIEVED CONTEXT ==========\n")


    # ========================================================
    # Phi-3 Prompt
    # ============================================================

    final_prompt = f"""
    <|system|>
    You are a BIFS 614 course tutor.

    Your knowledge for this question is limited to the COURSE CONTEXT
    provided below.

    Answer the QUESTION using only claims explicitly supported by the
    COURSE CONTEXT.

    You may summarize or paraphrase the COURSE CONTEXT, but do not
    introduce additional technical terminology, labels, named concepts,
    or examples unless those terms or concepts appear in COURSE CONTEXT.

    Before answering, silently check each sentence against COURSE CONTEXT.
    Remove any statement that cannot be supported by the supplied text.
    Do not mention your checks or the words COURSE CONTEXT in the answer.

    Do not add facts from your pretrained knowledge, even if those
    facts are correct.

    IMPORTANT:
    Every factual claim in your answer must be traceable to information
    stated in the COURSE CONTEXT.

    For definition questions such as "What is X?", use the definition
    or description given in the COURSE CONTEXT. Do not expand the
    definition using outside knowledge.

    For questions asking "why", "how", "what are some examples",
    advantages, disadvantages, or uses, include the relevant supporting
    information found in the COURSE CONTEXT.

    If the COURSE CONTEXT does not contain enough information to answer
    the QUESTION, respond exactly:

    I could not find the answer in the provided context.

    Prefer the terminology used in the lectures. For example, if the
    context describes a tree, call it a tree; do not introduce another
    technical name for it unless that name appears in the context.

    Give a direct answer in 1-3 sentences. Stop when the QUESTION has
    been answered.
    <|end|>

    <|user|>
    COURSE CONTEXT:
    {context}

    QUESTION:
    {user_prompt}
    <|end|>

    <|assistant|>
    """


    # ========================================================
    # Tokenize Prompt
    # ========================================================

    input_ids = tokenizer.encode(
        final_prompt,
        return_tensors="pt"
    ).to(model.device)

    input_token_count = input_ids.shape[1]

#     print(f"Input Tokens: {input_token_count}")


    # ========================================================
    # Generate Answer
    # ========================================================

    start = time.time()

    with torch.no_grad():

        output_ids = model.generate(
            input_ids,

            # Allow enough room for a short course answer while
            # discouraging unnecessary long responses.
            max_new_tokens=120,

            # Deterministic generation is preferable for
            # grounded course question answering.
            do_sample=False,

            # Slightly discourage repetitive generation.
            repetition_penalty=1.05,

            # Allow Phi-3's end-of-turn token to stop generation.
            eos_token_id=END_TOKEN_ID,

            pad_token_id=tokenizer.eos_token_id
        )

    generation_time = time.time() - start

#     print("Generation:", generation_time, "seconds")


    # ========================================================
    # Extract Generated Tokens Only
    # ========================================================

    generated_ids = output_ids[0][input_token_count:]

    response = tokenizer.decode(
        generated_ids,
        skip_special_tokens=True,
        clean_up_tokenization_spaces=False
    )

    response = response.strip()


    # ========================================================
    # Remove Any Unexpected Role Tags
    # ========================================================

    for stop_tag in [
        "<|user|>",
        "<|assistant|>",
        "<|system|>",
        "<|end|>"
    ]:

        if stop_tag in response:
            response = response.split(stop_tag)[0].strip()


    # ========================================================
    # Empty Response Guardrail
    # ========================================================

    if not response:
        response = (
            "I could not find the answer in the provided context."
        )


    # ========================================================
    # Normalize unsupported-answer refusals to exact fallback.
    # Phi-3 sometimes says "I'm sorry, the context doesn't mention..."
    # instead of the required sentence. This handles recognizable
    # refusals, but cannot detect every unsupported generated claim.
    # ========================================================
    refusal_patterns = [
        r"\bi (?:could not|cannot|can't|am unable to) (?:find|answer|provide)\b",
        r"\b(?:no|not enough|insufficient) (?:relevant )?information\b",
        r"\b(?:does not|doesn't|do not) (?:mention|contain|provide|include)\b",
        r"\b(?:there is|there's) no (?:information|mention|reference)\b",
        r"\bnot (?:mentioned|covered|found|available) in (?:the )?(?:provided )?(?:course )?context\b",
    ]
    if response == FALLBACK or any(
        re.search(pattern, response.lower()) for pattern in refusal_patterns
    ):
        response = FALLBACK

    # ========================================================
    # Optional terminology grounding check
    # ========================================================
    # This flags terms absent from the retrieved course text. It is NOT
    # an entailment check and does not guarantee source-only answers.
    suspect_terms = (unsupported_technical_terms(response, context)
                     if response != FALLBACK else [])

    if DEBUG_GROUNDING:
        print("\n[DEBUG] Retrieved course context:\n", context)
        if suspect_terms:
            print("[DEBUG] Potentially unsupported terminology:",
                  ", ".join(suspect_terms))
        else:
            print("[DEBUG] No unfamiliar long terms detected; factual"
                  " grounding is NOT guaranteed.")

    if STRICT_TERM_CHECK and suspect_terms:
        if DEBUG_GROUNDING:
            print("[DEBUG] Answer withheld by heuristic term check.")
        response = FALLBACK

    # ========================================================
    # Token Statistics
    # ========================================================

    output_token_count = len(generated_ids)

    total_token_count = (
        input_token_count + output_token_count
    )


    # ========================================================
    # Display Answer
    # ========================================================

    print("Tutor Response:", response)

